
while True:
    print("\n--- MENU ---")
    print("1 - Gerar tabuada")
    print("0 - Sair")

    opcao = input("Opção: ")

    if opcao == "0":
        print("Encerrando o programa...")
        break

    elif opcao == "1":
        numero = int(input("Número: "))

        for i in range(1, 11):
            print(numero, "x", i, "=", numero * i)

    else:
        print("Opção inválida!")
